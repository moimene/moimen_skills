        {
            "name": "template"
        }
    ],
    "meta": {
        "templateId": "W2_RAGGraph_Query",
        "description": "Query híbrido: pgvector (semántico) + LightRAG (conceptual) con fusión LLM",
        "instanceId": "exported-from-skill"
    }
}